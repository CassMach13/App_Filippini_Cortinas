{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "hosting": {
    "site": "filippini-cortinas",
    "public": "public",
    "ignore": [
      "firebase.json",
      "firestore.rules",
      "firestore.indexes.json",
      "firebase-config.example.js",
      "README.md",
      "docs/**",
      "tests/**",
      "scripts/**",
      "Gravacoes de Tela/**",
      "Orcamentos/**",
      "Screenshots/**",
      "Tutoriais/**",
      "WhatsApp Image 2026-*",
      "*.docx",
      "*.pdf",
      "*.mp4",
      "*.log",
      "package.json",
      "package-lock.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          },
          {
            "key": "X-Frame-Options",
            "value": "DENY"
          },
          {
            "key": "Referrer-Policy",
            "value": "same-origin"
          },
          {
            "key": "Permissions-Policy",
            "value": "camera=(), microphone=(), geolocation=()"
          }
        ]
      },
      {
        "source": "/",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      },
      {
        "source": "**/*.@(html|js)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      }
    ]
  }
}
